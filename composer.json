{
    "name": "tanat/php-worker-pool",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "PhpWorkerPool\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpWorkerPool\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-shmop": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "php-cs-fixer fix --diff",
        "format:check": "php-cs-fixer fix --diff --dry-run"
    },
    "config": {
        "sort-packages": true
    }
}
